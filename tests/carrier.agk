# Finding the carrier: flying east away from it, the carrier drops off screen
# and a yellow pointer at the play area's left edge points back at it; the
# HUD's compass arrow by CARRIER points west.
wait-serial "AGK t0" 3000   # (the floppy loads run after the splash: seconds)
wait 10
press fire 2
wait-serial "theatre loaded=0"
# (the theatre card first: a fresh press of fire skips it)
wait 3
press fire 1
wait 24
press up 160
wait 20
screenshot away
expect-color away 13 105 0xFC2
expect-color away 57 251 0xDEF near 2
expect-no-serial "AGK ERR"
