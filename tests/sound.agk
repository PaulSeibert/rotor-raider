# The title theme plays; in play the rotor chops, the gun cracks, a bomb whistles.
wait-serial "AGK t0" 3000   # (the floppy loads run after the splash: seconds)
mark title
wait 50
mark title_end
expect-sound title title_end
# (dog68 where it fits: 1 MB+ chip)
expect-serial "music (theme|dog68)"
press fire 2
wait-serial "theatre loaded=0"
# (the theatre card first: a fresh press of fire skips it)
wait 3
press fire 1
wait 24
press up 40
mark gun
press fire 1
wait 10
mark gun_end
expect-sound gun gun_end
expect-serial "sfx cannon"
# 1.4: in the air the rotor borrows Paula channel 0 (no music there on 512 KB,
# or dog70's first minute on 1 MB chip, whose voice 0 is silent then)
expect-serial "rotor on channel 0"
