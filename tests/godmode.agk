# GODMODE by a factory and its AA turrets for half a minute: hit after hit,
# the gunship flies on, damage 0, 4 lives.
wait-serial "AGK t0" 3000   # (the floppy loads run after the splash: seconds)
wait 10
press fire 2
wait-serial "theatre loaded=0"
# (the theatre card first: a fresh press of fire skips it)
wait 3
press fire 1
wait 24
key 0x63
key 0x28
wait 5
key 0x0A
wait 30
key 0x63
key 0x28
wait 5
key 0x09
wait 1500
expect-serial "hit ignored"
expect-no-serial "gunship lost"
expect-no-serial "damage=[1-9]"
