# Boot: the Desert Palms Software logo, then the title over the slowly panning
# theatre: the ROTOR RAIDER logo, the credit and copyright, the steering, the HUD.
wait 60
screenshot logo
expect-color logo 120 22 0xFA2
wait-serial "AGK t0"
wait 60
screenshot title
expect-serial "state=0"
# the title logo's yellow top, the copyright sign's C, the HUD
expect-color title 34 26 0xFC2 near 2
expect-color title 75 78 0xFEC near 1
expect-color title 4 229 0xFEC near 2
expect-no-serial "AGK ERR"
