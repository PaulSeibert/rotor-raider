# Boot: the Desert Palms Software logo, then the title over the slowly panning
# theatre: the ROTOR RAIDER logo, the credit and copyright, the steering, the HUD.
wait 60
screenshot logo
expect-color logo 120 22 0xFA2
wait-serial "AGK t0"
wait 60
screenshot title
expect-serial "state=0"
# the chrome logo (the copper's colours: steel blue, then gold, down RAIDER),
# the copyright sign, the HUD (its labels coloured by the copper)
expect-color title 60 64 0x8BD
expect-color title 40 72 0xEB5
expect-color title 75 116 0xFEC
expect-color title 1 229 0xFE5
expect-no-serial "AGK ERR"
