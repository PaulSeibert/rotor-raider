# Boot: the Desert Palms Software logo, then the title over the slowly panning
# theatre: the ROTOR RAIDER logo (art/tools/make_title_logo.py), the credit
# and copyright, the steering, the HUD.
wait 60
screenshot logo
expect-color logo 120 22 0xFA2
wait-serial "AGK t0" 3000   # (the floppy loads run after the splash: seconds)
wait 60
screenshot title
expect-serial "state=0"
# the logo (the copper's colours per line: ROTOR's orange, RAIDER's blue),
# the copyright sign under it, the HUD (its labels coloured by the copper)
expect-color title 112 90 0xF60
expect-color title 100 104 0x2BF
expect-color title 51 164 0xFEC
expect-color title 1 229 0xFE5
expect-no-serial "AGK ERR"
