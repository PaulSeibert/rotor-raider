# Typing the initials on the Amiga keyboard (a DPS requirement, 1.5): the same
# game as hiscore.agk up to the entry (GODMODE, the test jump, three bombs, the
# normal skill, the game ended with Ctrl+L, E). Then the keys: Esc (0x45, the
# game must not quit), P (0x19), M (0x37), Backspace (0x41, takes the M back),
# R (0x13), S (0x21: the third letter ends the entry), Return (0x44, nothing
# left to confirm). The table must show PRS, and typing P and M must not have
# paused the game or muted the music (the game's own keys are off during the
# entry). Keys are held 25 frames by the emulator.
wait-serial "AGK t0" 3000   # (the floppy loads run after the splash: seconds)
expect-serial "AGK scores default\nAGK scores names=DPS/PRS/KES/MIR/ACE\nAGK top=10000 last=500"
wait 10
press fire 2
wait-serial "theatre loaded=0"
# (the theatre card first: a fresh press of fire skips it)
wait 3
press fire 1
wait 24
key 0x63
key 0x28
wait 5
key 0x0A
wait 30
key 0x63
key 0x28
wait 5
key 0x09
wait 20
press fire2 2
wait 40
press fire2 2
wait 40
press fire2 2
wait-serial "factory destroyed"
wait 40
key 0x63
key 0x28
wait 5
key 0x03
wait 20
key 0x63
key 0x28
wait 5
key 0x12
wait-serial "state=7" 100
wait 60
key 0x45
wait 28
screenshot typing0
key 0x19
wait 3
key 0x37
wait 3
screenshot typing1
key 0x41
wait 3
key 0x13
wait 3
screenshot typing2
key 0x21
wait-serial "state=6" 40
key 0x44
wait-serial "scores names=" 600
wait 40
screenshot table
# fifth, between the defaults' 1,500 and 500 (which drops off): the typed PRS
expect-serial "AGK scores saved\nAGK scores names=DPS/PRS/KES/MIR/PRS\nAGK top=10000 last=1\d{3}"
expect-no-serial "AGK paused"
expect-no-serial "AGK music switched"
expect-no-serial "AGK ERR"
